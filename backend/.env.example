# Railway fournit automatiquement DATABASE_URL via le plugin PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/db?schema=public"

# JWT
JWT_SECRET="change-this-to-a-random-secret"
JWT_REFRESH_SECRET="change-this-to-another-random-secret"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Serveur
PORT=4000
NODE_ENV=production

# Frontend URL (CORS) — mettre l'URL Vercel après déploiement
FRONTEND_URL="https://ton-app.vercel.app"

# Upload
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE=10485760
