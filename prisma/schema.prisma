// Schéma Prisma pour l'ERP Juridique
// PostgreSQL est le moteur de base de données
// Chaque modèle correspond à une table PostgreSQL

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── UTILISATEURS ─────────────────────────────────────────────
// Stocke tous les comptes : avocats (admin) et clients
// Le mot de passe est hashé avec bcrypt
// Le refreshToken est stocké pour la gestion des sessions
model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  password     String
  nom          String
  prenom       String
  telephone    String?
  role         String   @default("admin") // admin | client
  isActive     Boolean  @default(true)
  refreshToken String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  lastLogin    DateTime?

  // Relations
  client        Client?        @relation(fields: [clientId], references: [id])
  clientId      String?        @unique @db.Uuid
  notifications Notification[]
  activities    Activity[]
  reminderEvents ReminderEvent[]
  reminders     Reminder[]

  @@map("users")
}

// ─── CLIENTS ───────────────────────────────────────────────────
// Informations détaillées des clients du cabinet
// Chaque client a un compte utilisateur associé (User)
model Client {
  id           String   @id @default(uuid()) @db.Uuid
  nom          String
  prenom       String
  cin          String   @unique
  telephone    String
  adresse      String?
  ville        String?
  profession   String?
  photo        String?
  email        String?
  statut       String   @default("actif") // actif | inactif
  observations String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  user  User?
  cases Case[]
  reminderEvents ReminderEvent[]

  @@map("clients")
}

// ─── DOSSIERS ──────────────────────────────────────────────────
// Cœur du système : chaque dossier appartient à un client
// Peut utiliser un modèle (template) pour la checklist
model Case {
  id          String   @id @default(uuid()) @db.Uuid
  reference   String   @unique
  mahakimRef  String?
  tribunal    String?
  type        String
  sousType    String?
  dateCreation DateTime @default(now())
  etat        String   @default("en_cours") // en_cours | cloture | suspendu
  description String?
  notes       String?
  progress    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  clientId   String    @db.Uuid
  client     Client    @relation(fields: [clientId], references: [id], onDelete: Cascade)
  templateId String?   @db.Uuid
  template   CaseTemplate? @relation(fields: [templateId], references: [id])
  caseTypeId String?   @db.Uuid
  caseType   CaseType? @relation(fields: [caseTypeId], references: [id])

  documents    Document[]
  hearings     Hearing[]
  checklist    CaseChecklistItem[]
  payments     Payment[]
  activities   Activity[]
  reminderEvents ReminderEvent[]

  @@map("cases")
}

// ─── TYPES D'AFFAIRES (القضايا) ──────────────────────────────
// Liste des types d'affaires configurable par l'admin
// Utilisé comme liste déroulante lors de la création d'un dossier
model CaseType {
  id          String   @id @default(uuid()) @db.Uuid
  nameAr      String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  documents CaseTypeDocument[]
  cases     Case[]

  @@map("case_types")
}

// ─── DOCUMENTS OBLIGATOIRES PAR TYPE D'AFFAIRE ──────────────
// Chaque type d'affaire a sa liste de documents requis
model CaseTypeDocument {
  id          String   @id @default(uuid()) @db.Uuid
  nameAr      String
  description String?
  isRequired  Boolean  @default(true)
  order       Int      @default(0)
  createdAt   DateTime @default(now())

  // Relations
  caseTypeId String  @db.Uuid
  caseType   CaseType @relation(fields: [caseTypeId], references: [id], onDelete: Cascade)

  @@map("case_type_documents")
}

// ─── MODÈLES DE DOSSIERS ──────────────────────────────────────
// Templates prédéfinis : Vol, Divorce, Succession, etc.
// Chaque modèle a une liste de documents obligatoires
model CaseTemplate {
  id          String   @id @default(uuid()) @db.Uuid
  nom         String
  slug        String   @unique
  description String?
  createdAt   DateTime @default(now())

  // Relations
  documents CaseTemplateDocument[]
  cases     Case[]

  @@map("case_templates")
}

// ─── DOCUMENTS OBLIGATOIRES PAR MODÈLE ────────────────────────
// Définit les documents requis pour chaque type de dossier
model CaseTemplateDocument {
  id          String   @id @default(uuid()) @db.Uuid
  nom         String
  obligatoire Boolean  @default(true)
  ordre       Int      @default(0)
  createdAt   DateTime @default(now())

  // Relations
  templateId String      @db.Uuid
  template   CaseTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@map("case_template_documents")
}

// ─── CHECKLIST PAR DOSSIER ─────────────────────────────────────
// Instance de la checklist pour un dossier spécifique
// Permet de cocher/décocher les documents obligatoires
model CaseChecklistItem {
  id         String   @id @default(uuid()) @db.Uuid
  nom        String
  obligatoire Boolean @default(true)
  ordre      Int      @default(0)
  coche      Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  casId     String @db.Uuid
  cas       Case   @relation(fields: [casId], references: [id], onDelete: Cascade)
  documents Document[]

  @@map("case_checklist_items")
}

// ─── TYPES DE DOCUMENTS CONFIGURABLES ─────────────────────────
// Table de configuration : l'avocat peut créer/modifier/supprimer
// des types de documents sans toucher au code
model DocumentType {
  id        String   @id @default(uuid()) @db.Uuid
  nom       String
  slug      String   @unique
  icon      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  documents Document[]

  @@map("document_types")
}

// ─── DOCUMENTS ─────────────────────────────────────────────────
// Fichiers PDF uploadés et attachés à un dossier
model Document {
  id              String   @id @default(uuid()) @db.Uuid
  nom             String
  description     String?
  fileName        String
  filePath        String
  fileSize        Int?
  auteur          String?
  etat            String   @default("en_attente") // en_attente | valide | rejete
  commentaires    String?
  uploadedAt      DateTime @default(now())
  isClientVisible Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Relations
  casId  String       @db.Uuid
  cas    Case         @relation(fields: [casId], references: [id], onDelete: Cascade)
  typeId String?      @db.Uuid
  type   DocumentType? @relation(fields: [typeId], references: [id])
  checklistItemId String?       @db.Uuid
  checklistItem   CaseChecklistItem? @relation(fields: [checklistItemId], references: [id])

  @@map("documents")
}

// ─── AUDIENCES ─────────────────────────────────────────────────
// Suivi des audiences pour chaque dossier
model Hearing {
  id        String   @id @default(uuid()) @db.Uuid
  date      DateTime
  heure     String?
  type      String?
  tribunal  String?
  salle     String?
  juge      String?
  statut    String   @default("planifiee") // planifiee | tenue | reportee | annulee
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  casId String @db.Uuid
  cas   Case   @relation(fields: [casId], references: [id], onDelete: Cascade)

  @@map("hearings")
}

// ─── NOTIFICATIONS ─────────────────────────────────────────────
// Notifications pour les utilisateurs (audience, document, etc.)
model Notification {
  id            String   @id @default(uuid()) @db.Uuid
  titre         String
  message       String
  type          String   // audience | document | dossier | paiement
  lu            Boolean  @default(false)
  referenceType String?  // Type d'entité référencée
  referenceId   String?  // ID de l'entité référencée
  createdAt     DateTime @default(now())

  // Relations
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

// ─── ACTIVITÉS (HISTORIQUE) ───────────────────────────────────
// Enregistre toutes les actions pour l'historique
model Activity {
  id          String   @id @default(uuid()) @db.Uuid
  action      String   // creation | modification | suppression | upload | download | export | login
  entity      String   // client | case | document | hearing | payment
  entityId    String?  @db.Uuid
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  // Relations
  userId String @db.Uuid
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  casId  String? @db.Uuid
  cas    Case?   @relation(fields: [casId], references: [id])

  @@map("activities")
}

// ─── PAIEMENTS ─────────────────────────────────────────────────
// Enregistrement des paiements pour chaque dossier
model Payment {
  id        String   @id @default(uuid()) @db.Uuid
  montant   Float
  date      DateTime
  mode      String   // especes | cheques | virement
  reference String?
  notes     String?
  createdAt DateTime @default(now())

  // Relations
  casId String @db.Uuid
  cas   Case   @relation(fields: [casId], references: [id], onDelete: Cascade)

  @@map("payments")
}

// ─── ÉVÉNEMENTS DE RAPPEL ──────────────────────────────────────
// Événements créés par l'utilisateur (audience, rendez-vous, tâche, échéance)
// Le système calcule automatiquement les rappels associés
enum EventType {
  RENDEZ_VOUS
  AUDIENCE
  TACHE
  ECHEANCE
}

enum Priority {
  FAIBLE
  NORMALE
  IMPORTANTE
  URGENTE
}

model ReminderEvent {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @db.Uuid
  title       String
  description String?
  clientId    String?   @db.Uuid
  caseId      String?   @db.Uuid
  type        EventType @default(AUDIENCE)
  date        DateTime
  time        String?
  lieu        String?
  priority    Priority  @default(NORMALE)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  client    Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  cas       Case?     @relation(fields: [caseId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@map("reminder_events")
}

// ─── RAPPELS AUTOMATIQUES ──────────────────────────────────────
// Générés automatiquement à partir des événements
// Chaque événement génère 5 rappels : J-7, J-3, J-1, H-2, M-30
model Reminder {
  id          String   @id @default(uuid()) @db.Uuid
  eventId     String   @db.Uuid
  userId      String   @db.Uuid
  title       String
  description String?
  remindAt    DateTime
  notified    Boolean  @default(false)
  dismissed   Boolean  @default(false)
  createdAt   DateTime @default(now())

  event ReminderEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reminders")
}

// ─── PARAMÈTRES ────────────────────────────────────────────────
// Stocke les paramètres généraux du logiciel
model Setting {
  id        String   @id @default(uuid()) @db.Uuid
  key       String   @unique
  value     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("settings")
}
